# PostgreSQL
POSTGRES_USER=avatars
POSTGRES_PASSWORD=avatars
POSTGRES_DB=avatars
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=localhost

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DOCKER_HOST=avatars.minio
S3_BUCKET=avatars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Hosts for docker-compose
POSTGRES_DOCKER_HOST=avatars.db
RABBITMQ_DOCKER_HOST=avatars.rabbitmq
S3_DOCKER_ENDPOINT=http://avatars.minio:9000

# API / Worker
ADDRESS=:8080
API_PORT=8080
LOG_LEVEL=info
MAX_UPLOAD_BYTES=5242880

# Database and RabbitMQ connection strings
DATABASE_DSN=postgres://avatars:avatars@localhost:5432/avatars?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
